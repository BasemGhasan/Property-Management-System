# Task #2 Part 3 — installs and configures the unified CloudWatch agent on the
# Elastic Beanstalk instance so memory/disk metrics are published to CloudWatch.
# EC2 only reports CPU by default; memory needs this agent.
#
# Requires the CloudWatchAgentServerPolicy managed policy attached to the EB
# instance role (aws-elasticbeanstalk-ec2-role) so the agent can call
# cloudwatch:PutMetricData.

files:
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
    mode: "000600"
    owner: root
    group: root
    content: |
      {
        "metrics": {
          "namespace": "PropMS/ElasticBeanstalk",
          "append_dimensions": {
            "InstanceId": "${aws:InstanceId}"
          },
          "metrics_collected": {
            "mem": {
              "measurement": ["mem_used_percent"],
              "metrics_collection_interval": 60
            },
            "disk": {
              "measurement": ["used_percent"],
              "resources": ["/"],
              "metrics_collection_interval": 60
            }
          }
        }
      }

commands:
  01_install_cwagent:
    command: "yum install -y amazon-cloudwatch-agent"
  02_start_cwagent:
    command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json"
  03_restart_cwagent:
    # Belt-and-suspenders full restart so the agent re-reads instance role
    # credentials fresh on every deploy, in case the IAM policy was attached
    # after the agent process had already started.
    command: "systemctl restart amazon-cloudwatch-agent"
