# Task #2 Part 3 — installs the unified CloudWatch agent and its config on the
# Elastic Beanstalk instance so memory/disk metrics are published to CloudWatch.
# EC2 only reports CPU by default; memory needs this agent.
#
# Requires the CloudWatchAgentServerPolicy managed policy attached to the EB
# instance role (aws-elasticbeanstalk-ec2-role) so the agent can call
# cloudwatch:PutMetricData.
#
# NOTE: the agent is NOT started here. This runs in the PreBuild phase, and EB's
# own "Log Streaming" feature stops amazon-cloudwatch-agent.service later in the
# same deploy (since Log Streaming is disabled on this environment). The agent
# is actually started by .platform/hooks/postdeploy/01_start_cwagent.sh, which
# runs after that EB step so it isn't immediately stopped again.

files:
  "/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json":
    mode: "000600"
    owner: root
    group: root
    content: |
      {
        "metrics": {
          "namespace": "PropMS/ElasticBeanstalk",
          "append_dimensions": {
            "InstanceId": "${aws:InstanceId}"
          },
          "metrics_collected": {
            "mem": {
              "measurement": ["mem_used_percent"],
              "metrics_collection_interval": 60
            },
            "disk": {
              "measurement": ["used_percent"],
              "resources": ["/"],
              "metrics_collection_interval": 60
            }
          }
        }
      }

commands:
  01_install_cwagent:
    command: "yum install -y amazon-cloudwatch-agent"
